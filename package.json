{
  "name": "artboard.ing",
  "displayName": "Artboarding",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "web app for advanced image generation on an infinite canvas",
  "homepage": "https://artboard.ing",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/artboard.ing.git"
  },
  "imports": {
    "#component/*": "./src/components/*/index.tsx",
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "bun run vite build && bun scripts/check-secrets.ts",
    "build:development": "bun run vite build --mode development",
    "check": "bun run lint && bun run test && bun run build && bun run test-browser",
    "dev": "bun scripts/dev.ts",
    "lint": "tsc --noEmit --noUnusedLocals --pretty false",
    "start": "bun scripts/server.ts",
    "test": "bun test --max-concurrency 1 ./test && bun run test-dom",
    "test-browser": "bun scripts/test-browser.ts",
    "test-dom": "bun test --preload ./test/happydom.ts ./test/components.dom.ts",
    "vite": "bun --bun node_modules/vite/dist/node/cli --configLoader native"
  },
  "overrides": {
    "typescript": "npm:typescript-classic@6.0.4"
  },
  "patchedDependencies": {
    "happy-dom@21.0.4": "patches/happy-dom@21.0.4.patch",
    "monacozen@0.6.0": "patches/monacozen@0.6.0.patch"
  },
  "dependencies": {
    "ai": "7.0.172",
    "antimono": "0.1.0",
    "clsx": "2.1.1",
    "idb": "8.0.4",
    "lucide-react": "1.72.0",
    "minimatch": "11.0.8",
    "monacozen": "0.6.0",
    "mount-root": "0.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.2.0",
    "react-resizable-panels": "4.22.1",
    "read-permalink": "0.4.0",
    "@ai-sdk/provider": "4.0.38",
    "@jsquash/jxl": "1.3.0"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "eslint-config-jaid": "37.1.0",
    "puppeteer-core": "25.17.0",
    "sass-embedded": "1.108.2",
    "tsconfig-jaid-react": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "vite": "8.3.8",
    "vite-plugin-media-mixins": "0.10.0",
    "vite-plugin-title": "0.6.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}